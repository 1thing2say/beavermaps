{
  "name": "beavermaps",
  "version": "1.0.0",
  "private": true,
  "description": "Campus map: search, browse, building cards and walking directions.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "HTTPS=1 concurrently -n api,web -c magenta,cyan \"node server/index.js\" \"vite\"",
    "dev:http": "concurrently -n api,web -c magenta,cyan \"node server/index.js\" \"vite\"",
    "dev:https": "npm run dev",
    "dev:web": "vite",
    "server": "node server/index.js",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "node --test test/[!.]*.test.js",
    "test:watch": "node --test --watch test/[!.]*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm test",
    "deploy": "if ! git diff --quiet || ! git diff --cached --quiet || [ -n \"$(git ls-files --others --exclude-standard src server)\" ]; then echo 'deploy: refusing - commit first. fly deploy uploads the working tree, not HEAD, so what went live would be a tree no commit and no CI run has seen.' >&2; exit 1; fi; [ -f .env ] || { echo 'deploy: no .env - it supplies VITE_MAPBOX_TOKEN and VITE_GOOGLE_MAPS_KEY as build args (README, Deploy).' >&2; exit 1; }; npm run check && set -a && . ./.env && set +a && case \"$VITE_MAPBOX_TOKEN\" in pk.*) ;; *) echo 'deploy: .env has no pk.* VITE_MAPBOX_TOKEN, and the image build refuses without one.' >&2; exit 1;; esac && fly deploy --build-arg VITE_MAPBOX_TOKEN=\"$VITE_MAPBOX_TOKEN\" --build-arg VITE_GOOGLE_MAPS_KEY=\"$VITE_GOOGLE_MAPS_KEY\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1thing2say/beavermaps.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/1thing2say/beavermaps/issues"
  },
  "homepage": "https://github.com/1thing2say/beavermaps#readme",
  "devDependencies": {
    "@deck.gl/core": "^9.3.10",
    "@deck.gl/extensions": "^9.3.10",
    "@deck.gl/geo-layers": "^9.3.10",
    "@loaders.gl/3d-tiles": "^4.4.4",
    "@loaders.gl/core": "^4.4.4",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@turf/along": "^7.3.5",
    "@turf/nearest-point": "^7.3.5",
    "@turf/nearest-point-on-line": "^7.3.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "compression": "^1.8.1",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "mapbox-gl": "^3.23.1",
    "spin.js": "^4.1.2",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.13"
  },
  "dependencies": {
    "@turf/bearing": "^7.3.5",
    "@turf/distance": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "express": "^5.2.1",
    "geojson-path-finder": "^2.1.0"
  },
  "overrides": {
    "fflate": "^0.8.3",
    "image-size": "^2.0.4"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "fsevents@2.3.3": true
  }
}
